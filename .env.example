DATABASE_URL=
SESSION_SECRET=change-me-to-a-long-random-string
# RustFS (S3-compatible). S3_ENDPOINT is used by the server, S3_PUBLIC_ENDPOINT in URLs sent to browsers.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
# "docker" runs latexmk inside texlive/texlive (for dev on a host without TeX), "local" runs latexmk directly.
LATEX_RUNNER=docker
LATEX_DOCKER_IMAGE=texlive/texlive:latest
# First admin account, created by `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
